#!/usr/bin/env bash
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/Users/ryyppy/dotfiles/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

print_only=0
refresh=0
use_focused=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --print)
      print_only=1
      shift
      ;;
    --refresh)
      refresh=1
      shift
      ;;
    --focused)
      use_focused=1
      shift
      ;;
    -h|--help)
      cat <<'EOF'
Usage: herdr-open-pr [--print] [--refresh] [--focused]

Open the GitHub pull request associated with the current git branch.
Uses a small Herdr-owned cache for snappy repeated opens and falls back to gh.

Options:
  --focused  Resolve the current branch from Herdr's focused pane cwd instead of $PWD.
EOF
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

debug_log() {
  local message="$1"
  local log_dir="${HERDR_PR_LOG_DIR:-$HOME/.cache/herdr}"
  mkdir -p "$log_dir"
  printf '[%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$message" >> "$log_dir/open-pr.log" 2>/dev/null || true
}

open_url() {
  local url="$1"

  if [[ "$print_only" == 1 ]]; then
    printf '%s\n' "$url"
    return
  fi

  case "$(uname)" in
    Darwin) open "$url" ;;
    Linux) xdg-open "$url" >/dev/null 2>&1 & ;;
    *) python3 -m webbrowser "$url" ;;
  esac
}

notify_herdr() {
  local title="$1"
  local body="${2:-}"

  [[ "$print_only" == 0 ]] || return 0
  command -v herdr >/dev/null 2>&1 || return 0

  herdr notification show "$title" --body "$body" --position bottom-right --sound none >/dev/null 2>&1 || true
}

open_pr_url() {
  local url="$1"
  local title="$2"
  local body="$3"

  notify_herdr "$title" "$body"
  open_url "$url"
}

normalize_github_remote() {
  python3 - "$1" <<'PY'
import re
import sys

remote = sys.argv[1]
patterns = [
    r'^git@github\.com:([^/]+)/(.+?)(?:\.git)?$',
    r'^https://github\.com/([^/]+)/(.+?)(?:\.git)?$',
    r'^ssh://git@github\.com/([^/]+)/(.+?)(?:\.git)?$',
]

for pattern in patterns:
    match = re.match(pattern, remote)
    if match:
        print(f'{match.group(1)}/{match.group(2)}')
        raise SystemExit(0)

raise SystemExit(1)
PY
}

cache_get() {
  local cache="$1"
  local key="$2"

  [[ -f "$cache" ]] || return 1

  python3 - "$cache" "$key" <<'PY' 2>/dev/null
import json
import sys

cache, key = sys.argv[1:3]
with open(cache, encoding='utf-8') as f:
    data = json.load(f)

entry = data.get('entries', {}).get(key)
if isinstance(entry, dict) and entry.get('url'):
    print(json.dumps(entry, separators=(',', ':')))
else:
    raise SystemExit(1)
PY
}

select_pr() {
  PR_JSON_INPUT="$1" python3 <<'PY'
import json
import os

value = json.loads(os.environ['PR_JSON_INPUT'])
if isinstance(value, list):
    prs = [pr for pr in value if isinstance(pr, dict) and pr.get('url')]
    prs.sort(key=lambda pr: pr.get('updatedAt') or '', reverse=True)
    if prs:
        print(json.dumps(prs[0], separators=(',', ':')))
        raise SystemExit(0)
elif isinstance(value, dict) and value.get('url'):
    print(json.dumps(value, separators=(',', ':')))
    raise SystemExit(0)

raise SystemExit(1)
PY
}

pr_url() {
  PR_JSON_INPUT="$1" python3 <<'PY'
import json
import os

pr = json.loads(os.environ['PR_JSON_INPUT'])
url = pr.get('url')
if url:
    print(url)
else:
    raise SystemExit(1)
PY
}

pr_number() {
  PR_JSON_INPUT="$1" python3 <<'PY'
import json
import os

pr = json.loads(os.environ['PR_JSON_INPUT'])
number = pr.get('number')
if number:
    print(number)
else:
    raise SystemExit(1)
PY
}

focused_pane_cwd() {
  command -v herdr >/dev/null 2>&1 || return 1

  herdr api snapshot 2>/dev/null | python3 -c '
import json
import sys

try:
    snapshot = json.load(sys.stdin)["result"]["snapshot"]
except Exception:
    raise SystemExit(1)

focused_pane_id = snapshot.get("focused_pane_id")
for pane in snapshot.get("panes", []):
    if pane.get("pane_id") == focused_pane_id:
        cwd = pane.get("foreground_cwd") or pane.get("cwd")
        if cwd:
            print(cwd)
            raise SystemExit(0)

raise SystemExit(1)
'
}

cache_put() {
  local cache="$1"
  local key="$2"
  local root="$3"
  local branch="$4"
  local repo="$5"
  local pr_json="$6"
  local cache_dir tmp

  cache_dir="$(dirname "$cache")"
  mkdir -p "$cache_dir"
  tmp="${cache}.$$"

  PR_JSON="$pr_json" python3 - "$cache" "$key" "$root" "$branch" "$repo" > "$tmp" <<'PY'
import json
import os
import sys
import time

cache, key, root, branch, repo = sys.argv[1:6]
try:
    with open(cache, encoding='utf-8') as f:
        data = json.load(f)
except Exception:
    data = {}

if not isinstance(data, dict):
    data = {}

entries = data.setdefault('entries', {})
pr = json.loads(os.environ['PR_JSON'])
entries[key] = {
    'url': pr.get('url'),
    'number': pr.get('number'),
    'title': pr.get('title'),
    'state': pr.get('state'),
    'updatedAt': pr.get('updatedAt'),
    'repo': repo,
    'branch': branch,
    'root': root,
    'cached_at': int(time.time()),
}
data['version'] = 1
json.dump(data, sys.stdout, indent=2, sort_keys=True)
sys.stdout.write('\n')
PY

  mv "$tmp" "$cache"
}

debug_log "start print=$print_only refresh=$refresh focused=$use_focused pwd=$PWD PATH=$PATH git=$(command -v git || true) gh=$(command -v gh || true) herdr=$(command -v herdr || true) python3=$(command -v python3 || true) HERDR_WORKSPACE_ID=${HERDR_WORKSPACE_ID:-} HERDR_TAB_ID=${HERDR_TAB_ID:-} HERDR_PANE_ID=${HERDR_PANE_ID:-}"

if [[ "$use_focused" == 1 ]]; then
  focused_cwd="$(focused_pane_cwd || true)"
  debug_log "focused_cwd=${focused_cwd:-<none>}"
  if [[ -n "$focused_cwd" ]]; then
    cd "$focused_cwd"
  fi
fi

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$root" ]]; then
  debug_log "error root_not_found pwd=$PWD"
  notify_herdr "Can't open PR" "Not inside a git repository"
  echo 'herdr-open-pr: not inside a git repository' >&2
  exit 1
fi

branch="$(git -C "$root" branch --show-current 2>/dev/null || true)"
if [[ -z "$branch" ]]; then
  debug_log "error branch_not_found root=$root"
  notify_herdr "Can't open PR" "Current checkout is not on a branch"
  echo 'herdr-open-pr: current checkout is not on a branch' >&2
  exit 1
fi

remote="$(git -C "$root" remote get-url origin 2>/dev/null || git -C "$root" remote get-url "$(git -C "$root" remote | head -n 1)" 2>/dev/null || true)"
repo="$(normalize_github_remote "$remote" 2>/dev/null || true)"
if [[ -z "$repo" ]]; then
  debug_log "error repo_parse_failed remote=$remote root=$root branch=$branch"
  notify_herdr "Can't open PR" "Could not parse GitHub remote: $remote"
  echo "herdr-open-pr: could not parse GitHub remote: $remote" >&2
  exit 1
fi

cache="${HERDR_PR_CACHE:-$HOME/.cache/herdr/prs.json}"
key="$repo|$branch"
debug_log "resolved root=$root branch=$branch repo=$repo key=$key"

if [[ "$refresh" == 0 ]]; then
  cached_pr_json="$(cache_get "$cache" "$key" || true)"
  if [[ -n "$cached_pr_json" ]]; then
    debug_log "cache hit key=$key"
    cached_url="$(pr_url "$cached_pr_json")"
    cached_number="$(pr_number "$cached_pr_json" || true)"
    if [[ -n "$cached_number" ]]; then
      open_pr_url "$cached_url" "Opening PR #$cached_number" "$repo · $branch"
    else
      open_pr_url "$cached_url" 'Opening PR' "$repo · $branch"
    fi
    exit 0
  fi
fi

pr_json=''
list_json="$(gh pr list --repo "$repo" --head "$branch" --state all --json number,title,url,state,updatedAt --limit 20 2>/dev/null || true)"
if [[ -n "$list_json" ]]; then
  pr_json="$(select_pr "$list_json" || true)"
fi
debug_log "gh list branch=$branch matched=$([[ -n "$pr_json" ]] && echo yes || echo no)"

# Fallback to gh's current-branch PR resolution for cases where --head is not
# enough, such as fork/head-owner edge cases.
if [[ -z "$pr_json" ]]; then
  view_json="$(gh pr view "$branch" --repo "$repo" --json number,title,url,state,updatedAt 2>/dev/null || true)"
  if [[ -n "$view_json" ]]; then
    pr_json="$(select_pr "$view_json" || true)"
  fi
fi
debug_log "gh view fallback matched=$([[ -n "$pr_json" ]] && echo yes || echo no)"

if [[ -z "$pr_json" ]]; then
  notify_herdr "Can't open PR" "No pull request found for $repo · $branch"
  echo "herdr-open-pr: no pull request found for $repo#$branch" >&2
  exit 1
fi

url="$(pr_url "$pr_json")"
number="$(pr_number "$pr_json" || true)"
cache_put "$cache" "$key" "$root" "$branch" "$repo" "$pr_json"

if [[ -n "$number" ]]; then
  open_pr_url "$url" "Opening PR #$number (caching...)" "$repo · $branch"
else
  open_pr_url "$url" 'Opening PR (caching...)' "$repo · $branch"
fi
