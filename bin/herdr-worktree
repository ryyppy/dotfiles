#!/usr/bin/env python3
"""Create Git worktrees and Herdr layouts from dotfiles-owned project configs."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import shlex
import subprocess
import sys
import tomllib
from dataclasses import dataclass
from pathlib import Path
from typing import Any

DOTFILES_DIR = Path(__file__).resolve().parents[1]
CONFIG_DIR = DOTFILES_DIR / "herdr" / "projects"


class CommandError(RuntimeError):
    pass


@dataclass
class Context:
    dry_run: bool


@dataclass
class WorktreeResult:
    path: Path
    label: str
    metadata: dict[str, str]
    branch: str
    created: bool


def log(message: str) -> None:
    print(message, file=sys.stderr)


def run(args: list[str], *, cwd: Path | None = None, capture: bool = False, ctx: Context) -> str:
    rendered = " ".join(shlex.quote(arg) for arg in args)
    if cwd is not None:
        rendered = f"(cd {shlex.quote(str(cwd))} && {rendered})"

    if ctx.dry_run:
        log(f"dry-run: {rendered}")
        return ""

    if capture:
        result = subprocess.run(args, cwd=cwd, text=True, capture_output=True, check=False)
        if result.returncode != 0:
            detail = (result.stderr or result.stdout or "").strip()
            raise CommandError(f"command failed: {rendered}\n{detail}")
        return result.stdout

    result = subprocess.run(args, cwd=cwd, check=False)
    if result.returncode != 0:
        raise CommandError(f"command failed: {rendered}")
    return ""


def run_json(args: list[str], *, cwd: Path | None = None, ctx: Context) -> dict[str, Any]:
    output = run(args, cwd=cwd, capture=True, ctx=ctx)
    if ctx.dry_run:
        return {}
    try:
        value = json.loads(output)
    except json.JSONDecodeError as exc:
        raise CommandError(f"failed to parse JSON from {' '.join(args)}: {exc}") from exc
    if not isinstance(value, dict):
        raise CommandError(f"expected JSON object from {' '.join(args)}")
    return value


def read_command(args: list[str], *, cwd: Path | None = None) -> str:
    result = subprocess.run(args, cwd=cwd, text=True, capture_output=True, check=False)
    if result.returncode != 0:
        return ""
    return result.stdout.strip()


def git_output(args: list[str], *, cwd: Path, ctx: Context) -> str:
    if ctx.dry_run:
        rendered = " ".join(shlex.quote(arg) for arg in ["git", *args])
        log(f"dry-run: read (cd {shlex.quote(str(cwd))} && {rendered})")
        return read_command(["git", *args], cwd=cwd)
    return run(["git", *args], cwd=cwd, capture=True, ctx=ctx).strip()


def parse_github_remote(remote: str) -> str | None:
    patterns = [
        r"^git@github\.com:([^/]+)/(.+?)(?:\.git)?$",
        r"^https://github\.com/([^/]+)/(.+?)(?:\.git)?$",
        r"^ssh://git@github\.com/([^/]+)/(.+?)(?:\.git)?$",
    ]
    for pattern in patterns:
        match = re.match(pattern, remote)
        if match:
            return f"{match.group(1)}/{match.group(2)}"
    return None


def slug(value: str) -> str:
    value = re.sub(r"[^A-Za-z0-9._-]+", "-", value.strip())
    value = re.sub(r"-+", "-", value).strip("-._")
    return value or "worktree"


def agent_name(agent: str, handle: str) -> str:
    value = slug(f"{agent}-{handle}").lower().replace(".", "-")
    if not re.match(r"^[a-z]", value):
        value = f"{agent}-{value}"
    return value[:32].rstrip("-_")


def load_config(path: Path) -> dict[str, Any]:
    with path.open("rb") as f:
        return tomllib.load(f)


def current_git_root(ctx: Context) -> Path | None:
    if ctx.dry_run:
        try:
            output = subprocess.run(
                ["git", "rev-parse", "--show-toplevel"],
                text=True,
                capture_output=True,
                check=False,
            )
            if output.returncode == 0:
                return Path(output.stdout.strip()).resolve()
        except Exception:
            return None
    try:
        output = subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True, stderr=subprocess.DEVNULL)
        return Path(output.strip()).resolve()
    except subprocess.CalledProcessError:
        return None


def path_is_relative_to(path: Path, base: Path) -> bool:
    try:
        path.relative_to(base)
        return True
    except ValueError:
        return False


def find_config(explicit: str | None, project_name: str | None, ctx: Context) -> tuple[Path, dict[str, Any]]:
    if explicit and project_name:
        raise CommandError("--config and --project cannot be used together")

    if explicit:
        path = Path(explicit).expanduser().resolve()
        return path, load_config(path)

    if project_name:
        safe_name = slug(project_name)
        if safe_name != project_name:
            raise CommandError(f"invalid project name: {project_name!r}")
        path = (CONFIG_DIR / f"{project_name}.toml").resolve()
        if not path.exists():
            raise CommandError(f"project config not found: {path}")
        return path, load_config(path)

    configs = sorted(CONFIG_DIR.glob("*.toml"))
    if not configs:
        raise CommandError(f"no Herdr worktree project configs found in {CONFIG_DIR}")

    root = current_git_root(ctx)
    matches: list[tuple[Path, dict[str, Any]]] = []
    for path in configs:
        config = load_config(path)
        project = config.get("project", {})
        repo = Path(project.get("repo", "")).expanduser().resolve()
        worktree_dir = Path(project.get("worktree_dir", "")).expanduser().resolve()
        if root and (root == repo or path_is_relative_to(root, worktree_dir)):
            matches.append((path, config))

    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        names = ", ".join(str(path) for path, _ in matches)
        raise CommandError(f"multiple matching configs found: {names}")

    raise CommandError(f"could not infer project config from current directory; pass --project or --config. Searched {CONFIG_DIR}")


def repo_slug(repo: Path, ctx: Context) -> str:
    remote = git_output(["remote", "get-url", "origin"], cwd=repo, ctx=ctx)
    parsed = parse_github_remote(remote)
    if not parsed:
        raise CommandError(f"could not parse GitHub origin remote: {remote}")
    return parsed


def gh_pr(pr_number: str, repo_path: Path, ctx: Context) -> dict[str, Any]:
    repo = repo_slug(repo_path, ctx)
    if ctx.dry_run:
        log(f"dry-run: would read GitHub PR #{pr_number} from {repo}")
        return {
            "number": int(pr_number),
            "title": f"PR {pr_number}",
            "url": f"https://github.com/{repo}/pull/{pr_number}",
            "headRefName": f"patrick/example-pr-{pr_number}",
            "baseRefName": "main",
        }

    return run_json(
        [
            "gh",
            "pr",
            "view",
            pr_number,
            "--repo",
            repo,
            "--json",
            "number,title,url,headRefName,baseRefName",
        ],
        ctx=ctx,
    )


def ensure_parent(path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)


def same_symlink(dest: Path, source: Path) -> bool:
    return dest.is_symlink() and Path(os.readlink(dest)) == source


def apply_file_ops(config: dict[str, Any], *, repo: Path, worktree: Path, ctx: Context) -> None:
    files = config.get("files", {})
    symlinks = files.get("symlink", []) or []
    copies = files.get("copy", []) or []

    for rel in symlinks:
        source = repo / rel
        dest = worktree / rel
        if ctx.dry_run:
            log(f"dry-run: symlink {dest} -> {source}")
            continue
        if not source.exists() and not source.is_symlink():
            log(f"warn: symlink source missing, skipping: {source}")
            continue
        if dest.exists() or dest.is_symlink():
            if same_symlink(dest, source):
                continue
            log(f"warn: destination exists, skipping symlink: {dest}")
            continue
        ensure_parent(dest)
        os.symlink(source, dest, target_is_directory=source.is_dir())

    for rel in copies:
        source = repo / rel
        dest = worktree / rel
        if ctx.dry_run:
            log(f"dry-run: copy {source} -> {dest}")
            continue
        if not source.exists():
            log(f"warn: copy source missing, skipping: {source}")
            continue
        if dest.exists() or dest.is_symlink():
            log(f"warn: destination exists, skipping copy: {dest}")
            continue
        ensure_parent(dest)
        if source.is_dir():
            shutil.copytree(source, dest, symlinks=True)
        else:
            shutil.copy2(source, dest)


def extract_id(response: dict[str, Any], *paths: tuple[str, ...]) -> str:
    for path in paths:
        value: Any = response
        for key in path:
            if not isinstance(value, dict) or key not in value:
                value = None
                break
            value = value[key]
        if isinstance(value, str) and value:
            return value
    raise CommandError(f"could not extract ID from Herdr response: {response}")


def herdr_env(metadata: dict[str, str]) -> list[str]:
    args: list[str] = []
    for key, value in metadata.items():
        if value:
            args.extend(["--env", f"{key}={value}"])
    return args


def command_with_env(command: str, metadata: dict[str, str]) -> str:
    exports = "; ".join(f"export {key}={shlex.quote(value)}" for key, value in metadata.items() if value)
    command = command.strip()
    return f"{exports}; {command}" if exports and command else command


def split_direction(value: str | None) -> str:
    if value in (None, "", "right"):
        return "right"
    if value == "down":
        return "down"
    if value == "vertical":
        return "right"
    if value == "horizontal":
        return "down"
    raise CommandError(f"unsupported split direction: {value}")


def setup_herdr_layout(
    config: dict[str, Any],
    *,
    worktree: Path,
    label: str,
    metadata: dict[str, str],
    prompt: str | None,
    ctx: Context,
) -> None:
    project = config.get("project", {})
    tabs = config.get("tabs", []) or []
    agent_kind = project.get("agent", "pi")

    if ctx.dry_run:
        log(f"dry-run: would open Herdr worktree workspace for {worktree} label={label}")
        workspace_id = "w-dry"
        current_tab_id = "w-dry:t1"
        current_root_pane_id = "w-dry:p1"
    else:
        response = run_json(["herdr", "worktree", "open", "--path", str(worktree), "--label", label, "--focus"], ctx=ctx)
        workspace_id = extract_id(response, ("result", "workspace", "workspace_id"))
        current_tab_id = extract_id(response, ("result", "tab", "tab_id"))
        current_root_pane_id = extract_id(response, ("result", "root_pane", "pane_id"), ("result", "pane", "pane_id"))

    focused_tab_id: str | None = None
    prompt_target: str | None = None

    for tab_index, tab in enumerate(tabs):
        tab_name = tab.get("name") or f"tab-{tab_index + 1}"
        if tab_index == 0:
            tab_id = current_tab_id
            root_pane_id = current_root_pane_id
            run(["herdr", "tab", "rename", tab_id, tab_name], ctx=ctx)
        else:
            tab_create_args = ["herdr", "tab", "create", "--workspace", workspace_id, "--cwd", str(worktree), "--label", tab_name, *herdr_env(metadata), "--no-focus"]
            if ctx.dry_run:
                run(tab_create_args, ctx=ctx)
                tab_id = f"w-dry:t{tab_index + 1}"
                root_pane_id = f"w-dry:p{tab_index + 1}1"
            else:
                response = run_json(tab_create_args, ctx=ctx)
                tab_id = extract_id(response, ("result", "tab", "tab_id"))
                root_pane_id = extract_id(response, ("result", "root_pane", "pane_id"), ("result", "pane", "pane_id"))

        if tab.get("focus"):
            focused_tab_id = tab_id

        panes = tab.get("panes", []) or [{}]
        pane_id = root_pane_id
        for pane_index, pane in enumerate(panes):
            if pane_index > 0:
                direction = split_direction(pane.get("split"))
                split_args = ["herdr", "pane", "split", "--pane", root_pane_id, "--direction", direction, "--cwd", str(worktree), *herdr_env(metadata), "--no-focus"]
                if ctx.dry_run:
                    run(split_args, ctx=ctx)
                    pane_id = f"{root_pane_id}-{pane_index + 1}"
                else:
                    response = run_json(split_args, ctx=ctx)
                    pane_id = extract_id(response, ("result", "pane", "pane_id"))

            command = pane.get("command")
            wants_agent = bool(pane.get("agent")) or command == "<agent>"
            if isinstance(command, str) and command.startswith("<agent:") and command.endswith(">"):
                wants_agent = True
                agent_kind = command.removeprefix("<agent:").removesuffix(">")

            if wants_agent:
                name = agent_name(agent_kind, label)
                run(["herdr", "agent", "start", name, "--kind", agent_kind, "--pane", pane_id], ctx=ctx)
                prompt_target = name
            elif isinstance(command, str) and command.strip():
                run(["herdr", "pane", "run", pane_id, command_with_env(command, metadata)], ctx=ctx)

            if pane.get("focus"):
                focused_tab_id = tab_id

    if focused_tab_id:
        run(["herdr", "tab", "focus", focused_tab_id], ctx=ctx)

    if prompt and prompt_target:
        run(["herdr", "agent", "prompt", prompt_target, prompt], ctx=ctx)
    elif prompt:
        log("warn: prompt provided, but no agent pane was configured")


def find_git_worktree(repo: Path, path: Path, ctx: Context) -> dict[str, str] | None:
    target = path.resolve()
    for worktree in git_worktrees(repo, ctx):
        if Path(worktree["path"]).resolve() == target:
            return worktree
    return None


def verify_existing_worktree(repo: Path, path: Path, expected_branch: str, ctx: Context) -> None:
    worktree = find_git_worktree(repo, path, ctx)
    if not worktree:
        raise CommandError(f"path already exists but is not a Git worktree for this repo: {path}")

    actual_branch = worktree.get("branch", "")
    if actual_branch and actual_branch != expected_branch:
        raise CommandError(f"worktree already exists at {path}, but branch is {actual_branch!r}; expected {expected_branch!r}")


def create_or_open_worktree(
    config: dict[str, Any],
    *,
    branch: str | None,
    base: str | None,
    pr_number: str | None,
    name: str | None,
    ctx: Context,
) -> WorktreeResult:
    project = config.get("project", {})
    repo = Path(project["repo"]).expanduser().resolve()
    worktree_dir = Path(project["worktree_dir"]).expanduser().resolve()
    metadata: dict[str, str] = {}

    if pr_number:
        pr = gh_pr(pr_number, repo, ctx)
        head_ref = str(pr.get("headRefName") or f"pr-{pr_number}")
        handle = slug(name or head_ref)
        local_branch = head_ref
        path = worktree_dir / handle
        metadata.update(
            {
                "HERDR_HANDLE": handle,
                "HERDR_PR_NUMBER": str(pr.get("number") or pr_number),
                "HERDR_PR_URL": str(pr.get("url") or ""),
                "HERDR_BASE_REF": str(pr.get("baseRefName") or ""),
                "HERDR_HEAD_REF": head_ref,
            }
        )

        if not path.exists():
            run(["git", "fetch", "origin", f"pull/{pr_number}/head:refs/heads/{local_branch}"], cwd=repo, ctx=ctx)
            run(["git", "worktree", "add", str(path), local_branch], cwd=repo, ctx=ctx)
            return WorktreeResult(path=path, label=handle, metadata=metadata, branch=local_branch, created=True)

        verify_existing_worktree(repo, path, local_branch, ctx)
        log(f"worktree already exists, opening: {path}")
        return WorktreeResult(path=path, label=handle, metadata=metadata, branch=local_branch, created=False)

    if not branch:
        raise CommandError("branch name is required unless --pr is provided")

    handle = name or slug(branch)
    path = worktree_dir / slug(handle)
    base_ref = base or git_output(["branch", "--show-current"], cwd=Path.cwd(), ctx=ctx)
    if not base_ref:
        raise CommandError("could not determine base branch; pass --base")

    metadata.update(
        {
            "HERDR_HANDLE": slug(handle),
            "HERDR_BASE_REF": base_ref,
            "HERDR_HEAD_REF": branch,
        }
    )

    label = slug(handle)
    if not path.exists():
        run(["git", "worktree", "add", "-b", branch, str(path), base_ref], cwd=repo, ctx=ctx)
        return WorktreeResult(path=path, label=label, metadata=metadata, branch=branch, created=True)

    verify_existing_worktree(repo, path, branch, ctx)
    log(f"worktree already exists, opening: {path}")
    return WorktreeResult(path=path, label=label, metadata=metadata, branch=branch, created=False)


def git_worktrees(repo: Path, ctx: Context) -> list[dict[str, str]]:
    output = git_output(["worktree", "list", "--porcelain"], cwd=repo, ctx=ctx)
    worktrees: list[dict[str, str]] = []
    current: dict[str, str] = {}

    for line in output.splitlines():
        if not line:
            if current:
                worktrees.append(current)
                current = {}
            continue

        key, _, value = line.partition(" ")
        if key == "worktree":
            current["path"] = str(Path(value).resolve())
        elif key == "branch" and value.startswith("refs/heads/"):
            current["branch"] = value.removeprefix("refs/heads/")
        elif key == "detached":
            current["detached"] = "true"

    if current:
        worktrees.append(current)

    return worktrees


def herdr_worktrees(repo: Path) -> list[dict[str, Any]]:
    if shutil.which("herdr") is None:
        return []

    output = read_command(["herdr", "worktree", "list", "--cwd", str(repo)])
    if not output:
        return []

    try:
        decoded = json.loads(output)
    except json.JSONDecodeError:
        return []

    worktrees = decoded.get("result", {}).get("worktrees", [])
    if isinstance(worktrees, list):
        return [worktree for worktree in worktrees if isinstance(worktree, dict)]
    return []


def open_herdr_workspace_id(repo: Path, path: Path) -> str | None:
    target = path.resolve()
    for worktree in herdr_worktrees(repo):
        if Path(str(worktree.get("path", ""))).expanduser().resolve() == target:
            workspace_id = worktree.get("open_workspace_id")
            if isinstance(workspace_id, str) and workspace_id:
                return workspace_id
    return None


def herdr_agent_for_worktree(kind: str, path: Path) -> str | None:
    if shutil.which("herdr") is None:
        return None

    output = read_command(["herdr", "agent", "list"])
    if not output:
        return None

    try:
        decoded = json.loads(output)
    except json.JSONDecodeError:
        return None

    target = path.resolve()
    agents = decoded.get("result", {}).get("agents", [])
    if not isinstance(agents, list):
        return None

    for agent in agents:
        if not isinstance(agent, dict) or agent.get("agent") != kind:
            continue
        cwd = agent.get("foreground_cwd") or agent.get("cwd")
        if cwd and Path(str(cwd)).expanduser().resolve() == target:
            pane_id = agent.get("pane_id")
            if isinstance(pane_id, str) and pane_id:
                return pane_id
    return None


def resolve_remove_targets(config: dict[str, Any], names: list[str], ctx: Context) -> list[dict[str, str]]:
    project = config.get("project", {})
    repo = Path(project["repo"]).expanduser().resolve()
    worktree_dir = Path(project["worktree_dir"]).expanduser().resolve()
    known = git_worktrees(repo, ctx)

    if not names:
        root = current_git_root(ctx)
        if not root:
            raise CommandError("not inside a git worktree; pass a worktree name")
        names = [str(root)]

    targets: list[dict[str, str]] = []
    for name in names:
        expanded = Path(name).expanduser()
        possible_paths = []
        if expanded.is_absolute() or expanded.exists() or name.startswith("."):
            possible_paths.append(expanded.resolve())
        possible_paths.extend([(worktree_dir / name).resolve(), (worktree_dir / slug(name)).resolve()])

        match: dict[str, str] | None = None
        for worktree in known:
            path = Path(worktree["path"]).resolve()
            branch = worktree.get("branch", "")
            if path in possible_paths or path.name == name or branch == name:
                match = {"path": str(path), "branch": branch}
                break

        if not match:
            path = (worktree_dir / slug(name)).resolve()
            match = {"path": str(path), "branch": ""}

        path = Path(match["path"]).resolve()
        if path == repo:
            raise CommandError(f"refusing to remove main checkout: {path}")
        if not path_is_relative_to(path, worktree_dir):
            raise CommandError(f"refusing to remove path outside configured worktree_dir: {path}")

        targets.append(match)

    return targets


def confirm_remove(targets: list[dict[str, str]], *, force: bool, ctx: Context) -> None:
    if force or ctx.dry_run:
        return

    log("The following worktrees will be removed:")
    for target in targets:
        branch = f" ({target['branch']})" if target.get("branch") else ""
        log(f"  - {target['path']}{branch}")

    answer = input("Remove these worktrees? [y/N] ").strip().lower()
    if answer not in {"y", "yes"}:
        raise CommandError("aborted")


def assert_clean_worktree(path: Path, *, force: bool) -> None:
    if force:
        return

    status = read_command(["git", "-C", str(path), "status", "--porcelain"])
    if status:
        raise CommandError(f"worktree has uncommitted changes: {path}; use --force to override")


def remove_command(args: argparse.Namespace) -> None:
    ctx = Context(dry_run=args.dry_run)
    config_path, config = find_config(args.config, args.project, ctx)
    log(f"using config: {config_path}")

    repo = Path(config["project"]["repo"]).expanduser().resolve()
    targets = resolve_remove_targets(config, args.names, ctx)
    open_workspaces = herdr_worktrees(repo)

    for target in targets:
        path = Path(target["path"]).resolve()
        if not ctx.dry_run and not path.exists():
            raise CommandError(f"worktree path does not exist: {path}")
        if path.exists():
            assert_clean_worktree(path, force=args.force)

    confirm_remove(targets, force=args.force, ctx=ctx)

    for target in targets:
        path = Path(target["path"]).resolve()
        branch = target.get("branch", "")
        workspace_id = ""
        for worktree in open_workspaces:
            if Path(str(worktree.get("path", ""))).expanduser().resolve() == path:
                workspace_id = str(worktree.get("open_workspace_id") or "")
                break

        if workspace_id:
            command = ["herdr", "worktree", "remove", "--workspace", workspace_id]
            if args.force:
                command.append("--force")
            run(command, ctx=ctx)

        if ctx.dry_run or path.exists():
            command = ["git", "worktree", "remove"]
            if args.force:
                command.append("--force")
            command.append(str(path))
            run(command, cwd=repo, ctx=ctx)

        if branch and not args.keep_branch:
            run(["git", "branch", "-D" if args.force else "-d", branch], cwd=repo, ctx=ctx)


def add_command(args: argparse.Namespace) -> None:
    ctx = Context(dry_run=args.dry_run)
    config_path, config = find_config(args.config, args.project, ctx)
    log(f"using config: {config_path}")

    if args.pr and args.branch:
        raise CommandError("branch argument cannot be used with --pr; use --name for a custom PR worktree handle")
    if args.pr and args.base:
        raise CommandError("--base cannot be used with --pr")

    worktree = create_or_open_worktree(
        config,
        branch=args.branch,
        base=args.base,
        pr_number=args.pr,
        name=args.name,
        ctx=ctx,
    )

    repo = Path(config["project"]["repo"]).expanduser().resolve()
    workspace_id = None if args.force_layout else open_herdr_workspace_id(repo, worktree.path)
    if workspace_id:
        log(f"Herdr workspace already open for {worktree.path}; focusing {workspace_id}")
        run(["herdr", "workspace", "focus", workspace_id], ctx=ctx)

        if args.prompt:
            agent_kind = str(config.get("project", {}).get("agent", "pi"))
            target = herdr_agent_for_worktree(agent_kind, worktree.path)
            if target:
                run(["herdr", "agent", "prompt", target, args.prompt], ctx=ctx)
            else:
                log("warn: prompt provided, but no matching agent was found in the existing workspace")
        return

    apply_file_ops(config, repo=repo, worktree=worktree.path, ctx=ctx)
    setup_herdr_layout(config, worktree=worktree.path, label=worktree.label, metadata=worktree.metadata, prompt=args.prompt, ctx=ctx)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Create Git worktrees and Herdr layouts from project configs")
    subparsers = parser.add_subparsers(dest="command", required=True)

    add = subparsers.add_parser("add", help="Create/open a worktree and set up its Herdr workspace")
    add.add_argument("branch", nargs="?", help="New branch name for non-PR worktrees")
    add.add_argument("--pr", help="GitHub PR number to check out")
    add.add_argument("--base", help="Base ref for non-PR worktrees; defaults to the current branch")
    add.add_argument("--name", help="Custom worktree handle/label")
    add.add_argument("-p", "--prompt", help="Prompt to send to the configured agent after startup")
    add.add_argument("--project", help="Project config name from herdr/projects/<name>.toml")
    add.add_argument("--config", help="Path to a Herdr worktree TOML config")
    add.add_argument("--dry-run", action="store_true", help="Print planned commands without changing anything")
    add.add_argument("--force-layout", action="store_true", help="Set up tabs/panes even if the worktree is already open in Herdr")
    add.set_defaults(func=add_command)

    remove = subparsers.add_parser("rm", aliases=["remove"], help="Remove worktrees and matching Herdr workspaces")
    remove.add_argument("names", nargs="*", help="Worktree names, branch names, or paths; defaults to current worktree")
    remove.add_argument("-f", "--force", action="store_true", help="Skip confirmation and remove dirty worktrees/branches forcefully")
    remove.add_argument("-k", "--keep-branch", action="store_true", help="Keep the local branch; only remove Herdr workspace and worktree")
    remove.add_argument("--project", help="Project config name from herdr/projects/<name>.toml")
    remove.add_argument("--config", help="Path to a Herdr worktree TOML config")
    remove.add_argument("--dry-run", action="store_true", help="Print planned commands without changing anything")
    remove.set_defaults(func=remove_command)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        args.func(args)
    except CommandError as exc:
        print(f"herdr-worktree: {exc}", file=sys.stderr)
        return 1
    except KeyError as exc:
        print(f"herdr-worktree: missing required config key: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
